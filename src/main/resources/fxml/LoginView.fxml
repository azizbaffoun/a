<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.controllers.LoginController"
      style="-fx-background-color: white;"
      stylesheets="@../styles/login.css">
    
    <!-- Left side with illustration -->
    <VBox alignment="CENTER" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
        <ImageView fitWidth="400" preserveRatio="true">
            <Image url="@../log.png"/>
        </ImageView>
    </VBox>
    
    <!-- Right side with login form -->
    <VBox alignment="CENTER" style="-fx-background-color: #e8f5e9; -fx-padding: 40;" HBox.hgrow="ALWAYS">
        <VBox maxWidth="400" spacing="20">
            <!-- Logo and Title -->
            <VBox alignment="CENTER" spacing="10">
                <Text text="PaddlePro" 
                      style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #1a5f7a;"/>
                <Text text="Reserve Your Court, Play Your Game" 
                      style="-fx-font-size: 16px; -fx-fill: #666;"/>
            </VBox>
            
            <Text text="LOGIN" 
                  style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a5f7a;"/>
            
            <!-- Login Form -->
            <VBox spacing="15">
                <TextField fx:id="usernameField" promptText="Email Address"
                          style="-fx-background-color: white; -fx-border-color: transparent; 
                                 -fx-padding: 12; -fx-font-size: 14px;"/>
                
                <PasswordField fx:id="passwordField" promptText="Password"
                             style="-fx-background-color: white; -fx-border-color: transparent; 
                                    -fx-padding: 12; -fx-font-size: 14px;"/>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Text text="Sign Up" styleClass="clickable-text" 
                          style="-fx-fill: #1a5f7a; -fx-font-size: 14px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Text text="Forgot Password?" styleClass="clickable-text"
                          style="-fx-fill: #1a5f7a; -fx-font-size: 14px;"/>
                </HBox>
                
                <Button text="Sign In" onAction="#handleLogin"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; 
                               -fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 4;"/>
                
                <HBox spacing="10" alignment="CENTER">
                    <Text text="Privacy Policy" styleClass="clickable-text"
                          style="-fx-fill: #666; -fx-font-size: 12px;"/>
                    <Text text="•" style="-fx-fill: #666; -fx-font-size: 12px;"/>
                    <Text text="Terms of Service" styleClass="clickable-text"
                          style="-fx-fill: #666; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>
            
            <Label fx:id="errorLabel" textFill="RED" wrapText="true"/>
        </VBox>
    </VBox>
</HBox> 