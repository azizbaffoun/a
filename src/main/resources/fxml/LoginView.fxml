<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.pidev.controllers.LoginController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #f4f4f4;">
    
    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="0" 
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" 
          AnchorPane.rightAnchor="0">
        
        <padding>
            <Insets top="20" right="40" bottom="20" left="40"/>
        </padding>

        <Text text="Event Management System" 
              style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        
        <VBox alignment="CENTER" spacing="10" 
              style="-fx-background-color: white; -fx-padding: 20; 
                     -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);"
              maxWidth="400">
            
            <Text text="Login" style="-fx-font-size: 18px;"/>
            
            <TextField fx:id="usernameField" promptText="Email"
                       style="-fx-pref-width: 250; -fx-pref-height: 35;"/>
            
            <PasswordField fx:id="passwordField" promptText="Password"
                          style="-fx-pref-width: 250; -fx-pref-height: 35;"/>
            
            <Button text="Login" onAction="#handleLogin"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; 
                           -fx-pref-width: 250; -fx-pref-height: 35;"/>
            
            <Label fx:id="errorLabel" textFill="RED" wrapText="true"/>
        </VBox>
    </VBox>
</AnchorPane> 