<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.jappa.controllers.EditEmpruntController">
    <children>
        <Label text="Edit Emprunt" layoutX="14.0" layoutY="14.0" />
        <ComboBox fx:id="userIDComboBox" layoutX="14.0" layoutY="50.0" />
        <ComboBox fx:id="materielComboBox" layoutX="14.0" layoutY="100.0" />
        <DatePicker fx:id="dateEmpruntPicker" layoutX="14.0" layoutY="150.0" />
        <DatePicker fx:id="dateRetourPicker" layoutX="14.0" layoutY="200.0" />
        <ComboBox fx:id="statutEmpruntComboBox" layoutX="14.0" layoutY="250.0" />
        <Button text="Save" layoutX="14.0" layoutY="300.0" onAction="#handleSave" />
        <Button text="Cancel" layoutX="100.0" layoutY="300.0" onAction="#handleCancel" />
    </children>
</AnchorPane> 