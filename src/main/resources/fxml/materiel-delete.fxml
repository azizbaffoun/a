<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" styleClass="main-container" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.jappa.controllers.MaterielDeleteController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Delete Material" styleClass="page-title" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Materials List" styleClass="section-title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label fx:id="listHeader" styleClass="list-header"/>
        
        <TableView fx:id="materielTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="typeColumn" text="Type"/>
                <TableColumn fx:id="typeSportColumn" text="Sport Type"/>
                <TableColumn fx:id="prixColumn" text="Price"/>
                <TableColumn fx:id="dateReservationColumn" text="Reservation Date"/>
                <TableColumn fx:id="statutColumn" text="Status"/>
                <TableColumn fx:id="ownerTypeColumn" text="Owner Type"/>
                <TableColumn fx:id="actionColumn" text="Action"/>
            </columns>
        </TableView>
    </VBox>
</VBox> 