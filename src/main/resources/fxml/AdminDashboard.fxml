<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.pidev.controllers.AdminDashboardController"
            prefHeight="600.0" prefWidth="800.0">

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Text text="Admin Dashboard" fill="white" 
                  style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            
            <Separator/>
            
            <Button text="Event Management" onAction="#showEventManagement"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: LEFT;"
                    maxWidth="Infinity"/>
                    
            <Button text="Venue Management" onAction="#showVenueManagement"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: LEFT;"
                    maxWidth="Infinity"/>
                    
            <Button text="User Management" onAction="#showUserManagement"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: LEFT;"
                    maxWidth="Infinity"/>
                    
            <Button text="Reports" onAction="#showReports"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: LEFT;"
                    maxWidth="Infinity"/>
                    
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f4f4f4;">
            <VBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <Text text="Welcome to Admin Dashboard" 
                      style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Text text="Select an option from the sidebar to get started" 
                      style="-fx-font-size: 16px;"/>
                
                <!-- Dashboard Statistics -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox style="-fx-background-color: white; -fx-padding: 20; 
                                -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Text text="Total Events" style="-fx-font-size: 16px;"/>
                        <Text fx:id="totalEventsText" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <VBox style="-fx-background-color: white; -fx-padding: 20; 
                                -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Text text="Active Venues" style="-fx-font-size: 16px;"/>
                        <Text fx:id="activeVenuesText" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <VBox style="-fx-background-color: white; -fx-padding: 20; 
                                -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Text text="Total Users" style="-fx-font-size: 16px;"/>
                        <Text fx:id="totalUsersText" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane> 