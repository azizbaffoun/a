<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import java.net.URL?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.pidev.controllers.AdminDashboardController"
            prefHeight="600.0" prefWidth="800.0">
            
    <stylesheets>
        <URL value="@../styles/admin-dashboard.css" />
    </stylesheets>

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="15" styleClass="sidebar">
            <!-- Logo and Brand -->
            <VBox alignment="CENTER" spacing="5" styleClass="brand-container">
                <ImageView fitWidth="50" preserveRatio="true">
                    <Image url="@../log.png"/>
                </ImageView>
                <Label text="PaddlePro" styleClass="brand-text"/>
                <Label text="Admin Dashboard" styleClass="brand-subtitle"/>
            </VBox>
            
            <Separator styleClass="sidebar-separator"/>
            
            <Button text="Dashboard" onAction="#showDashboard" styleClass="nav-button">
                <graphic>
                    <Label text="D" styleClass="emoji-icon"/>
                </graphic>
            </Button>
            
            <Button text="Event Management" onAction="#showEventManagement" styleClass="nav-button">
                <graphic>
                    <Label text="E" styleClass="emoji-icon"/>
                </graphic>
            </Button>
                    
            <Button text="Venue Management" onAction="#showVenueManagement" styleClass="nav-button">
                <graphic>
                    <Label text="V" styleClass="emoji-icon"/>
                </graphic>
            </Button>
                    
            <Button text="User Management" onAction="#showUserManagement" styleClass="nav-button">
                <graphic>
                    <Label text="U" styleClass="emoji-icon"/>
                </graphic>
            </Button>
                    
            <Button text="API Management" onAction="#showApiManagement" styleClass="nav-button">
                <graphic>
                    <Label text="A" styleClass="emoji-icon"/>
                </graphic>
            </Button>
                    
            <Button text="Reports" onAction="#showReports" styleClass="nav-button">
                <graphic>
                    <Label text="R" styleClass="emoji-icon"/>
                </graphic>
            </Button>
                    
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button">
                <graphic>
                    <Label text="🚪" styleClass="emoji-icon"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <VBox alignment="CENTER" spacing="30" styleClass="welcome-container">
                <Label text="Welcome to Admin Dashboard" styleClass="welcome-text"/>
                <Label text="Select an option from the sidebar to get started" styleClass="welcome-subtitle"/>
                
                <!-- Dashboard Statistics -->
                <HBox spacing="30" alignment="CENTER">
                    <VBox styleClass="stat-card">
                        <Label text="E" styleClass="emoji-icon"/>
                        <Label text="Total Events" styleClass="stat-label"/>
                        <Label fx:id="totalEventsText" text="0" styleClass="stat-value"/>
                    </VBox>
                    
                    <VBox styleClass="stat-card">
                        <Label text="V" styleClass="emoji-icon"/>
                        <Label text="Active Venues" styleClass="stat-label"/>
                        <Label fx:id="activeVenuesText" text="0" styleClass="stat-value"/>
                    </VBox>
                    
                    <VBox styleClass="stat-card">
                        <Label text="U" styleClass="emoji-icon"/>
                        <Label text="Total Users" styleClass="stat-label"/>
                        <Label fx:id="totalUsersText" text="0" styleClass="stat-value"/>
                    </VBox>

                    <VBox styleClass="stat-card">
                        <Label text="R" styleClass="emoji-icon"/>
                        <Label text="Revenue" styleClass="stat-label"/>
                        <Label fx:id="revenueText" text="0.00 DT" styleClass="stat-value"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane> 