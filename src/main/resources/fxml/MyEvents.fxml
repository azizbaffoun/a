<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.controllers.MyEventsController"
      spacing="10" style="-fx-padding: 20;">

    <Text text="My Events" 
          style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Events Table -->
    <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10">
        <Button text="View Details" onAction="#viewEventDetails"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Leave Event" onAction="#leaveEvent"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>
</VBox> 