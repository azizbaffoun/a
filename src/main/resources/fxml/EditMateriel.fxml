<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.jappa.controllers.EditMaterielController">
    <children>
        <Label text="Edit Material" layoutX="14.0" layoutY="14.0" />
        <TextField fx:id="typeField" layoutX="14.0" layoutY="50.0" />
        <TextField fx:id="typeSportField" layoutX="14.0" layoutY="100.0" />
        <TextField fx:id="prixField" layoutX="14.0" layoutY="150.0" />
        <DatePicker fx:id="dateReservationPicker" layoutX="14.0" layoutY="200.0" />
        <ComboBox fx:id="statutMaterielComboBox" layoutX="14.0" layoutY="250.0" />
        <Button text="Save" layoutX="14.0" layoutY="300.0" onAction="#handleSave" />
        <Button text="Cancel" layoutX="100.0" layoutY="300.0" onAction="#handleCancel" />
    </children>
</AnchorPane> 