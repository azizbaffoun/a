<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="469.0" prefWidth="712.0" styleClass="root" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.pidev.controllers.UserDashboardController">
    
    <!-- Left Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-background-color: rgba(26, 27, 46, 0.95); -fx-padding: 20;" styleClass="sidebar">
         <Button layoutX="30.0" layoutY="84.0" maxWidth="Infinity" onAction="#showDashboard" styleClass="menu-button" text="Dashboard" />
            <Button maxWidth="Infinity" onAction="#showMyEvents" styleClass="menu-button" text="My Events" />
            <Button maxWidth="Infinity" onAction="#showAvailableEvents" styleClass="menu-button" text="Available Events" />
            <Button maxWidth="Infinity" onAction="#showProfile" styleClass="menu-button" text="My Profile" />
            <Button maxWidth="Infinity" onAction="#showCaloriesBurned" styleClass="menu-button" text="Calories Burned" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-button" text="Logout" />
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: transparent;">
            <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40;">
                <Text styleClass="header-text" text="Welcome to Your Dashboard" />
                <Text styleClass="sub-header-text" text="Select an option from the sidebar to get started" />
                
                <!-- Statistics Cards -->
                <HBox alignment="CENTER" spacing="30">
                    <VBox styleClass="statistics-card">
                        <Text styleClass="card-title" text="My Events" />
                        <Text fx:id="myEventsCount" styleClass="card-value" text="0" />
                    </VBox>
                    
                    <VBox styleClass="statistics-card">
                        <Text styleClass="card-title" text="Available Events" />
                        <Text fx:id="availableEventsCount" styleClass="card-value" text="0" />
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
