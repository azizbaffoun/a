<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.pidev.controllers.UserDashboardController"
            prefHeight="600.0" prefWidth="800.0">
            
    <stylesheets>
        <URL value="@../styles/admin-dashboard.css"/>
    </stylesheets>

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="15" styleClass="sidebar">
            <!-- Logo and Brand -->
            <VBox alignment="CENTER" spacing="5" styleClass="brand-container">
                <ImageView fitWidth="50" preserveRatio="true">
                    <Image url="@../log.png"/>
                </ImageView>
                <Text text="PaddlePro" styleClass="brand-text"/>
                <Text text="User Dashboard" styleClass="brand-subtitle"/>
            </VBox>
            
            <Separator styleClass="sidebar-separator"/>
            
            <Button text="Dashboard" onAction="#showDashboard" styleClass="nav-button">
                <graphic>
                    <Text text="📊" style="-fx-font-family: 'Segoe UI Emoji';"/>
                </graphic>
            </Button>
            
            <Button text="My Events" onAction="#showMyEvents" styleClass="nav-button">
                <graphic>
                    <Text text="📅" style="-fx-font-family: 'Segoe UI Emoji';"/>
                </graphic>
            </Button>
            
            <Button text="Available Events" onAction="#showAvailableEvents" styleClass="nav-button">
                <graphic>
                    <Text text="🎾" style="-fx-font-family: 'Segoe UI Emoji';"/>
                </graphic>
            </Button>
            
            <Button text="My Profile" onAction="#showProfile" styleClass="nav-button">
                <graphic>
                    <Text text="👤" style="-fx-font-family: 'Segoe UI Emoji';"/>
                </graphic>
            </Button>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button">
                <graphic>
                    <Text text="🚪" style="-fx-font-family: 'Segoe UI Emoji';"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <VBox alignment="CENTER" spacing="30" styleClass="welcome-container">
                <Text text="Welcome to Your Dashboard" styleClass="welcome-text"/>
                <Text text="Select an option from the sidebar to get started" styleClass="welcome-subtitle"/>
                
                <!-- Dashboard Statistics -->
                <HBox spacing="30" alignment="CENTER">
                    <VBox styleClass="stat-card">
                        <Text text="📅" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 24px;"/>
                        <Text text="My Events" styleClass="stat-label"/>
                        <Text fx:id="myEventsCount" text="0" styleClass="stat-value"/>
                    </VBox>
                    
                    <VBox styleClass="stat-card">
                        <Text text="🎾" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 24px;"/>
                        <Text text="Available Events" styleClass="stat-label"/>
                        <Text fx:id="availableEventsCount" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
