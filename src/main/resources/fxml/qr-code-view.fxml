<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="10" styleClass="main-container" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.jappa.controllers.QRCodeController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Material ID:" />
        <TextField fx:id="materielIdField" promptText="Enter Material ID"/>
        <Button text="Generate QR Code" onAction="#handleGenerateQRCode"/>
        <Button text="Save QR Code" onAction="#handleSaveQRCode"/>
    </HBox>

    <ImageView fx:id="qrCodeImageView" fitWidth="300" fitHeight="300" preserveRatio="true"/>

    <TextArea fx:id="historyTextArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back" onAction="#handleBack"/>
    </HBox>
</VBox> 