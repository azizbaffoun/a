<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane styleClass="main-container" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.pidev.controllers.EventManagementController">

    <stylesheets>
        <URL value="@../styles/event-management.css" />
    </stylesheets>

    <VBox spacing="20" styleClass="content-container">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-container">
            <Text styleClass="header-text" text="Event Management" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="300" promptText="Search events..." styleClass="search-field" />
        </HBox>

        <!-- Main Content Area -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <!-- Left Panel - Event List -->
            <VBox spacing="10" styleClass="panel" HBox.hgrow="ALWAYS">
                <HBox spacing="10" styleClass="action-buttons">
                    <Button onAction="#showAddEventDialog" styleClass="action-button, add-button" text="Add Event" />
                    <Button onAction="#showEditEventDialog" styleClass="action-button, edit-button" text="Edit Event" />
                    <Button onAction="#deleteEvent" styleClass="action-button, delete-button" text="Delete Event" />
                </HBox>

                <TableView fx:id="eventTable" styleClass="event-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
                        <TableColumn fx:id="nameColumn" prefWidth="150" text="Name" />
                        <TableColumn fx:id="detailsColumn" prefWidth="200" text="Description" />
                        <TableColumn fx:id="startDateColumn" prefWidth="100" text="Start Date" />
                        <TableColumn fx:id="endDateColumn" prefWidth="100" text="End Date" />
                        <TableColumn fx:id="typeColumn" prefWidth="100" text="Type" />
                        <TableColumn fx:id="maxParticipantsColumn" prefWidth="120" text="Max Participants" />
                    </columns>
                    <effect>
                        <DropShadow color="#00000022" radius="10" spread="0.1" />
                    </effect>
                </TableView>
            </VBox>
        </HBox>

        <!-- Status Bar -->
        <HBox spacing="10" styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-text" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="totalEventsLabel" styleClass="status-text" />
        </HBox>
    </VBox>
</StackPane>
