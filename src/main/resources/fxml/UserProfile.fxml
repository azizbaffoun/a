<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox fx:id="profileContainer" spacing="20" styleClass="profile-container" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="tn.esprit.pidev.controllers.UserProfileController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <stylesheets>
        <URL value="@/styles/styles.css"/>
    </stylesheets>

    <!-- Profile Header -->
    <HBox alignment="CENTER" spacing="20" styleClass="profile-header">
        <ImageView fx:id="profileImage" fitHeight="100" fitWidth="100" styleClass="profile-image"/>
        <VBox alignment="CENTER_LEFT" spacing="5">
            <Label fx:id="usernameLabel" styleClass="profile-name"/>
            <Label fx:id="emailLabel" styleClass="profile-email"/>
            <Label fx:id="roleLabel" styleClass="profile-role"/>
        </VBox>
    </HBox>

    <!-- Edit Profile Section -->
    <VBox spacing="15" styleClass="edit-profile-section">
        <Label text="Edit Profile" styleClass="section-title"/>
        
        <GridPane hgap="10" vgap="10">
            <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            
            <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            
            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <Button fx:id="saveButton" text="Save Changes" 
                onAction="#handleSave" 
                styleClass="save-button"/>
    </VBox>

</VBox> 